  "private": true,
  "description": "Backend + API for Alaei Math Academy (Express + PostgreSQL, Render-ready)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
